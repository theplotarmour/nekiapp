{
  "components": {
    "schemas": {
      "Challenge": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "code_length": {
            "const": 6,
            "default": 6,
            "title": "Code Length",
            "type": "integer"
          },
          "delivery_status": {
            "const": "accepted",
            "default": "accepted",
            "title": "Delivery Status",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "resend_after": {
            "format": "date-time",
            "title": "Resend After",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "expires_at",
          "resend_after"
        ],
        "title": "Challenge",
        "type": "object"
      },
      "ErrorDetails": {
        "additionalProperties": false,
        "properties": {},
        "title": "ErrorDetails",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorPayload"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorPayload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/ErrorDetails"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details",
          "retryable"
        ],
        "title": "ErrorPayload",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "MobileRefresh": {
        "additionalProperties": false,
        "properties": {
          "client_kind": {
            "const": "mobile",
            "title": "Client Kind",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "refresh_token": {
            "maxLength": 4096,
            "minLength": 32,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "client_kind",
          "device_id",
          "refresh_token"
        ],
        "title": "MobileRefresh",
        "type": "object"
      },
      "MobileSession": {
        "additionalProperties": false,
        "properties": {
          "access_expires_at": {
            "format": "date-time",
            "title": "Access Expires At",
            "type": "string"
          },
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "client_kind": {
            "const": "mobile",
            "default": "mobile",
            "title": "Client Kind",
            "type": "string"
          },
          "profile_complete": {
            "title": "Profile Complete",
            "type": "boolean"
          },
          "refresh_expires_at": {
            "format": "date-time",
            "title": "Refresh Expires At",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "access_expires_at",
          "session_id",
          "user_id",
          "profile_complete",
          "refresh_token",
          "refresh_expires_at"
        ],
        "title": "MobileSession",
        "type": "object"
      },
      "OtpRequest": {
        "additionalProperties": false,
        "properties": {
          "client_kind": {
            "enum": [
              "mobile",
              "web"
            ],
            "title": "Client Kind",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "phone_e164": {
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "title": "Phone E164",
            "type": "string"
          }
        },
        "required": [
          "phone_e164",
          "device_id",
          "client_kind"
        ],
        "title": "OtpRequest",
        "type": "object"
      },
      "OtpVerify": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "client_kind": {
            "enum": [
              "mobile",
              "web"
            ],
            "title": "Client Kind",
            "type": "string"
          },
          "code": {
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "code",
          "device_id",
          "client_kind"
        ],
        "title": "OtpVerify",
        "type": "object"
      },
      "Privacy": {
        "additionalProperties": false,
        "properties": {
          "contributions_public": {
            "title": "Contributions Public",
            "type": "boolean"
          },
          "impact_sharing": {
            "title": "Impact Sharing",
            "type": "boolean"
          },
          "profile_public": {
            "title": "Profile Public",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "profile_public",
          "contributions_public",
          "impact_sharing",
          "version"
        ],
        "title": "Privacy",
        "type": "object"
      },
      "PrivacyUpdate": {
        "additionalProperties": false,
        "properties": {
          "contributions_public": {
            "title": "Contributions Public",
            "type": "boolean"
          },
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "impact_sharing": {
            "title": "Impact Sharing",
            "type": "boolean"
          },
          "profile_public": {
            "title": "Profile Public",
            "type": "boolean"
          }
        },
        "required": [
          "expected_version",
          "profile_public",
          "contributions_public",
          "impact_sharing"
        ],
        "title": "PrivacyUpdate",
        "type": "object"
      },
      "Profile": {
        "additionalProperties": false,
        "properties": {
          "account_status": {
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "DELETION_PENDING"
            ],
            "title": "Account Status",
            "type": "string"
          },
          "avatar_media_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Media Id"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "impact_statement": {
            "title": "Impact Statement",
            "type": "string"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          },
          "locale": {
            "const": "en-IN",
            "default": "en-IN",
            "title": "Locale",
            "type": "string"
          },
          "profile_complete": {
            "title": "Profile Complete",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "first_name",
          "last_name",
          "impact_statement",
          "profile_complete",
          "account_status",
          "version"
        ],
        "title": "Profile",
        "type": "object"
      },
      "ProfileUpdate": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "first_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "impact_statement": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Impact Statement"
          },
          "last_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          }
        },
        "required": [
          "expected_version"
        ],
        "title": "ProfileUpdate",
        "type": "object"
      },
      "Revocation": {
        "additionalProperties": false,
        "properties": {
          "revoked": {
            "const": true,
            "default": true,
            "title": "Revoked",
            "type": "boolean"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "version"
        ],
        "title": "Revocation",
        "type": "object"
      },
      "VersionCommand": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "expected_version"
        ],
        "title": "VersionCommand",
        "type": "object"
      },
      "WebRefresh": {
        "additionalProperties": false,
        "properties": {
          "client_kind": {
            "const": "web",
            "title": "Client Kind",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          }
        },
        "required": [
          "client_kind",
          "device_id"
        ],
        "title": "WebRefresh",
        "type": "object"
      },
      "WebSession": {
        "additionalProperties": false,
        "properties": {
          "access_expires_at": {
            "format": "date-time",
            "title": "Access Expires At",
            "type": "string"
          },
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "client_kind": {
            "const": "web",
            "default": "web",
            "title": "Client Kind",
            "type": "string"
          },
          "profile_complete": {
            "title": "Profile Complete",
            "type": "boolean"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "access_expires_at",
          "session_id",
          "user_id",
          "profile_complete"
        ],
        "title": "WebSession",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "NEKI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "platform_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "platform_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Database or migration revision unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VersionCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revocation"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Logout",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/auth/otp/request": {
      "post": {
        "operationId": "request_otp",
        "requestBody": {
          "content": {
