        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "mobile": "#/components/schemas/MobileSession",
                      "web": "#/components/schemas/WebSession"
                    },
                    "propertyName": "client_kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/WebSession"
                    },
                    {
                      "$ref": "#/components/schemas/MobileSession"
                    }
                  ],
                  "title": "Response Refresh Session"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
