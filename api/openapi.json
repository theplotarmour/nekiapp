        "summary": "Refresh Session",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "get_current_user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
