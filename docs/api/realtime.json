    "max_frame_bytes": 16384,
    "max_subscriptions": 20,
    "binary_frames": "reject",
    "limits_status": "proposed pending load and mobile testing"
  },
  "close_codes": {
    "1000": "Normal closure",
    "1008": "Authentication expiry, revocation, protocol or access violation",
    "1009": "Frame too large",
    "1011": "Server failure; obtain new ticket and restore snapshots"
