  "schemas": {
    "MissionPath": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100,
          "pattern": "^msn_[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "public_id"
      ]
    },
    "OrganizationPath": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100,
          "pattern": "^org_[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "public_id"
      ]
    },
    "PageModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "maxItems": 50,
          "minItems": 1
        },
        "canonical_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://"
        },
        "content_revision_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "APPROVED_INFORMATION"
          ]
        }
      },
      "required": [
        "title",
        "paragraphs",
        "canonical_url",
        "content_revision_id",
        "state"
      ]
    },
    "AndroidAssociation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relation": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "delegate_permission/common.handle_all_urls"
              ]
            },
            "minItems": 1,
            "maxItems": 1
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "namespace": {
                "type": "string",
                "enum": [
                  "android_app"
                ]
              },
              "package_name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200,
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
              },
              "sha256_cert_fingerprints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 95,
                  "maxLength": 95,
                  "pattern": "^(?:[A-F0-9]{2}:){31}[A-F0-9]{2}$"
                },
                "maxItems": 10,
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "namespace",
              "package_name",
              "sha256_cert_fingerprints"
            ]
          }
        },
        "required": [
          "relation",
          "target"
        ]
      }
    },
    "AppleAssociation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applinks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "details": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "appIDs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 12,
                      "maxLength": 250,
                      "pattern": "^[A-Z0-9]{10}\\.[A-Za-z0-9.-]+$"
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "components": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "/": {
                          "type": "string",
                          "enum": [
                            "/m/*",
                            "/o/*"
                          ]
                        }
                      },
                      "required": [
                        "/"
                      ]
                    }
                  }
                },
                "required": [
                  "appIDs",
                  "components"
                ]
              }
            }
          },
          "required": [
            "details"
          ]
        }
      },
      "required": [
        "applinks"
      ]
    },
    "HtmlResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer",
          "enum": [
            200,
            404,
            503
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Content-Type": {
              "type": "string",
              "enum": [
                "text/html; charset=utf-8"
              ]
            },
            "Cache-Control": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            },
            "Referrer-Policy": {
              "type": "string",
              "enum": [
                "no-referrer"
              ]
            },
            "X-Content-Type-Options": {
              "type": "string",
              "enum": [
                "nosniff"
              ]
            },
            "Content-Security-Policy": {
              "type": "string",
              "enum": [
                "default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
              ]
            }
          },
          "required": [
            "Content-Type",
            "Cache-Control",
            "Referrer-Policy",
            "X-Content-Type-Options",
            "Content-Security-Policy"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250000
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ]
    }
  },
